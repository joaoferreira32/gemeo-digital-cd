{
  "name": "gemeo-digital-cd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gêmeo digital de um centro de distribuição: simulação 3D em tempo real no navegador.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "bench": "tsx bench/run.ts",
    "bench:mapf": "tsx bench/mapf.ts",
    "bench:vigia": "tsx bench/vigia.ts",
    "bench:tempo": "tsx --expose-gc bench/tempo.ts",
    "bench:rotas": "tsx bench/rotas.ts",
    "bench:manutencao": "tsx bench/manutencao.ts",
    "bench:agenda": "tsx bench/agenda.ts",
    "bench:gargalo": "tsx bench/gargalo.ts",
    "bench:lab": "tsx bench/lab.ts",
    "bench:oscilacao": "tsx bench/oscilacao.ts",
    "mutate": "node scripts/mutate.mjs",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "onnxruntime-web": "^1.30.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
