      "edits": [
        {
          "file": "src/demo/cinema.ts",
          "find": "    case 'badge':\n      return 1;",
          "replace": "    case 'badge':\n      return 0;"
        }
      ]
    },
    {
      "name": "cada camada do raio-X conta só o próprio rótulo, sem o título",
