{
  "tests": ["tests/cinema.test.ts"],
  "mutations": [
    {
      "name": "o lado sem IA recebe a IA",
      "edits": [
        {
          "file": "src/demo/cinema-run.ts",
          "find": "      .filter((x) => side === 'ai' || !x.ai)",
          "replace": "      .filter(() => true)"
        }
      ]
    },
    {
      "name": "a volta no tempo não continua do passado",
      "edits": [
        {
          "file": "src/demo/cinema-run.ts",
          "find": "      rec.branch();\n",
          "replace": ""
        }
      ]
    },
    {
      "name": "o contador conta pelo caminho estático",
      "edits": [
        {
          "file": "src/demo/cinema-run.ts",
          "find": "waitingFor(this.rec.shown, this.conveyorQueues, this.dockQueues, 'next');",
          "replace": "waitingFor(this.rec.shown, this.conveyorQueues, this.dockQueues);"
        }
      ]
    },
    {
      "name": "a consulta do roteamento ignora o desvio",
