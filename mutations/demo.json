    {
      "name": "o checkpoint esquece se a agenda está ligada",
      "edits": [
        {
          "file": "src/sim/schedule.ts",
          "find": "    w.bool(this.on);\n",
          "replace": ""
        },
        {
          "file": "src/sim/schedule.ts",
          "find": "    this.on = r.bool();\n",
          "replace": ""
        }
      ]
    }
  ]
